# Dataset and dashboard
NUSCENES_DATAROOT=/workspace/data/nuscenes
NUSCENES_VERSION=v1.0-mini
AUTONOMY_OUTPUT_DIR=/workspace/autonomy-outputs
AUTONOMY_DEVICE=auto
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8888
HISTORY_FRAMES=4
FUTURE_FRAMES=6
TEMPORAL_MODEL=ema
PLANNER_MODE=classical
AUTONOMY_VERBOSE=2

# Optional WebRTC ICE configuration.
# The dashboard always has an HTTP image fallback, so these are not required
# to use the learning UI through a normal RunPod HTTP endpoint.
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=
PERSISTENT_ROOT=/workspace
AUTONOMY_REPO_DIR=/workspace/autonomy-learning-dashboard
VENV_DIR=/workspace/autonomy-learning-dashboard/.venv
AUTONOMY_LOG_DIR=/workspace/autonomy-logs
HARDWARE_INTERVAL=1
PROFILE_LEVEL=learning
# The startup script creates this file with mode 600; never commit it.
DASHBOARD_TOKEN_FILE=/workspace/.autonomy/dashboard.token
DASHBOARD_CONSOLE=1
# Set to 1 ONLY behind an actual authenticating proxy protecting HTTP AND WSS.
DASHBOARD_TRUST_PROXY_AUTH=0
